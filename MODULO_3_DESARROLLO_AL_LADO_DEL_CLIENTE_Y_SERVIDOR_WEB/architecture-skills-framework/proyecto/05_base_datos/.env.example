# ==============================================================================
# S3IH - VARIABLES DE CONEXIÓN A BASE DE DATOS (PLANTILLA SEGURA)
# NUNCA escribir contraseñas reales en este archivo versionado (RNF-034)
# ==============================================================================

# Entorno y Configuración General
APP_ENV=development
APP_NAME=S3IH_Hospitalario
APP_TIMEZONE=UTC

# Motor de Base de Datos Seleccionado (mysql / postgresql)
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=s3ih_db
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Credenciales de Servicio de la Aplicación Web (rol_s3ih_app - Sin DELETE)
DB_USER=s3ih_app_user
DB_PASSWORD=

# Credenciales del Worker Asíncrono de SLA y Outbox
WORKER_DB_USER=s3ih_worker_user
WORKER_DB_PASSWORD=

# Credenciales para Migraciones DDL (Solo pipeline CI/CD)
MIGRATOR_DB_USER=s3ih_migrator_user
MIGRATOR_DB_PASSWORD=

# Seguridad y Cifrado TLS en Tránsito (RNF-032)
DB_SSL_CA=
DB_SSL_VERIFY_SERVER_CERT=false

# Opciones de Timeout y Pool de Conexiones
DB_CONNECT_TIMEOUT=5
DB_LOCK_WAIT_TIMEOUT=5
